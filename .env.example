# Public origin
PUBLIC_APP_ORIGIN=http://localhost:3000

# Local development only. Production always requires authentication.
ALLOW_DEMO_AUTH=1

# OpenAI — required for AI answers, reports, screen analysis, document parsing, and live transcription
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_STRONG_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_VAD_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_DOCUMENT_MODEL=gpt-5.6-luna

# Auth0 — required only for standalone production auth; Sites-hosted builds inject authenticated user headers
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=

# Paddle — optional until paid web plans are enabled
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=

# RevenueCat — optional until mobile subscriptions are enabled
REVENUECAT_WEBHOOK_AUTH=

# Production integrity secrets — required in production
UPLOAD_SIGNING_SECRET=
DESKTOP_TOKEN_SIGNING_SECRET=
DELETION_CRON_SECRET=

# Optional monitoring. Never send transcript, audio, screenshot, or document contents.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
