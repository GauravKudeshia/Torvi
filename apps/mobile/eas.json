{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": { "distribution": "internal", "channel": "preview", "env": { "TORVI_REQUIRE_MOBILE_CONFIG": "1" } },
    "production": { "autoIncrement": true, "channel": "production", "env": { "TORVI_REQUIRE_MOBILE_CONFIG": "1" } }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_ID" },
      "android": { "track": "internal" }
    }
  }
}
