{
  "name": "@interview-copilot/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern '**/dist/**' --ignore-pattern '**/.next/**' --ignore-pattern '**/.vinext/**' --ignore-pattern '**/.expo/**' --ignore-pattern '**/target/**'",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts packages/contracts/tests/**/*.test.ts",
    "test:privacy": "node --test --import tsx tests/privacy.test.ts",
    "db:generate": "drizzle-kit generate",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "desktop:build": "pnpm --filter @interview-copilot/desktop build",
    "mobile:typecheck": "pnpm --filter @interview-copilot/mobile typecheck"
  },
  "dependencies": {
    "@interview-copilot/contracts": "workspace:*",
    "jose": "^6.1.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "openai": "^6.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "drizzle-orm": "0.45.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "tsx": "^4.20.6",
    "turbo": "^2.6.0",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "drizzle-kit": "0.31.10"
  },
  "type": "module"
}
