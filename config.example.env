# Public web origin
PUBLIC_APP_ORIGIN=https://app.example.com

# OpenAI (server secret; never expose through NEXT_PUBLIC_ or client bundles)
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_STRONG_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
# WebRTC native capture needs server-side turn boundaries; gpt-live-transcribe
# requires client commits, so desktop channels use this compatible fallback.
OPENAI_VAD_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_DOCUMENT_MODEL=gpt-5.6-luna

# Auth0 public OIDC + PKCE clients
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com
AUTH0_AUDIENCE=https://api.example.com
AUTH0_CLIENT_ID=

# Paddle Billing web subscriptions (sandbox or production)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=

# RevenueCat mobile entitlement normalization
REVENUECAT_WEBHOOK_AUTH=

# Privacy and request integrity
UPLOAD_SIGNING_SECRET=
DESKTOP_TOKEN_SIGNING_SECRET=
DELETION_CRON_SECRET=

# Monitoring (no transcript/audio/screenshot fields are ever sent)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_ENDPOINT=
